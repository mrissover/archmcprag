{
  "name": "arch-docs-mcp",
  "version": "1.0.0",
  "description": "MCP server providing semantic search access to architectural design documents",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "indexer": "tsx src/indexer/index.ts",
    "initial-load": "tsx scripts/initial-load.ts",
    "reindex": "tsx scripts/reindex.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "chromadb": "^3.2.0",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "gray-matter": "^4.0.0",
    "marked": "^15.0.0",
    "openai": "^6.16.0",
    "pino": "^9.0.0",
    "tiktoken": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
